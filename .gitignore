# =========================
# Unity Project .gitignore
# =========================
# Place this at the root of your Unity project directory

# =========================
# Unity generated folders
# =========================
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
ExportedObj/
.consulo/

# =========================
# Unity generated files
# =========================
*.log
*.pidb
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta
sysinfo.txt
mono_crash.*
*.booproj
*.svd

# =========================
# IDE / Editor
# =========================
.vs/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.DotSettings.user
.gradle/

# =========================
# Blender files
# =========================
*.blend1
*.blend1.meta

# =========================
# Builds / Packages
# =========================
*.apk
*.aab
*.app
*.unitypackage
*.unitypackage.meta
crashlytics-build.properties

# =========================
# Addressables / Visual Scripting
# =========================
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/AddressableAssetsData/*/*.bin*
/[Aa]ssets/Unity.VisualScripting.Generated/

# =========================
# Test / autogenerated
# =========================
InitTestScene*.unity*
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# =========================
# Asset Store tools (optional)
/[Aa]ssets/AssetStoreTools*

# =========================
# Git LFS tracking for large assets
# (track these in .gitattributes)
*.fbx
*.png
*.jpg
*.jpeg
*.tga
*.psd
*.wav
*.mp3
*.ogg
*.mp4
*.mov
